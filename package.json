{
  "name": "mak-erp",
  "version": "1.0.0",
  "description": "Enterprise Resource Planning system for MAK Tours and Travels",
  "private": true,
  "scripts": {
    "dev": "node dev.js",
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
