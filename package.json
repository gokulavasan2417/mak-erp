  "license": "ISC",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0"
  }
}
